# env files (every subproject has its own)
.env
**/.env
backend/.env.test

# Node
# No trailing slash: with one this matches only real directories, and a
# node_modules symlink (as a git worktree may use to share an install) would
# slip past it and get committed as a machine-specific absolute path.
node_modules
dist/
npm-debug.log*

# editor / OS
.DS_Store

# Playwright MCP scratch output (browser snapshots/console logs from the
# taste skill run — the analysis artifacts themselves are committed)
.playwright-mcp/
.vercel
.env*
