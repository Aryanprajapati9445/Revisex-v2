# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database — use Neon's POOLED connection string here (the one with
# "-pooler" in the hostname). This is app runtime traffic: many short-lived
# connections, which is exactly what PgBouncer transaction-pooling is for.
# The db/ layer's own .env uses the DIRECT string instead, for DDL — see
# db/README.md.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
