{
  "name": "college-notes-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema (source of truth) + generated migrations for the college notes platform. Package-independent, like the rest of db/ — backend/ imports this package's compiled output directly by relative path.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  }
}
