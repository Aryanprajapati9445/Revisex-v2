# Copy this file to .env and fill in your real Neon connection string.
# Get it from: Neon console -> your project -> Connect -> "Connection string"
#
# Use the DIRECT (non-pooled) connection here — the hostname has no
# "-pooler" in it. This runs migrations (schema-changing DDL) and the
# constraint/query suites; see db/README.md's Migrations section for why
# direct matters specifically for migrations.
#
# sslmode=require must stay in the string — Neon rejects unencrypted connections.
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require
